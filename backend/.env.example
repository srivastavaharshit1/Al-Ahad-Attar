# Copy this file to .env in the same directory (backend/.env) and fill in real values.
# .env is loaded automatically by the spring-dotenv dependency already in pom.xml —
# no extra setup needed beyond creating the file. Never commit the real .env file.

# Set to "prod" in production — switches to application-prod.yml, which turns off SQL/bind-value
# logging (application.yml's defaults log every bound parameter, including PII and password
# hashes, at DEBUG/TRACE — fine for local dev, not for a shared prod log aggregator).
SPRING_PROFILES_ACTIVE=

# --- Database (Supabase Postgres) ---
# From your Supabase project: Project Settings > Database > Connection string.
# Use the "Session pooler" (port 5432) string for a JDBC-friendly host, or the
# "Transaction pooler" (port 6543) if the app will scale across many instances.
DB_URL=jdbc:postgresql://<host>:<port>/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<your-db-password>

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Optional — defaults to 86400000 (24h) if unset.
JWT_EXPIRATION=86400000

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Razorpay Dashboard > Settings > Webhooks when you register https://<your-domain>/api/payment/webhook.
# Different from RAZORPAY_KEY_SECRET above. Required for /api/payment/webhook to accept anything —
# left unset, it fails closed and rejects every call.
RAZORPAY_WEBHOOK_SECRET=
# Set to true to simulate every checkout as a successful payment without calling Razorpay at all
# (no real keys needed). Frontend must also skip loading the Razorpay widget when the payment-create
# response has devMode:true — see Checkout.tsx. NEVER set true when SPRING_PROFILES_ACTIVE=prod —
# the app refuses to boot if both are set.
PAYMENT_DEV_MODE=false

# --- Bootstrap admin account (optional) ---
# Leave both blank to skip seeding an admin account entirely (recommended unless
# you need one immediately — a seeded admin is a live login the moment the app boots).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Demo customer accounts (optional) ---
# CatalogSeeder creates two demo customers (aisha.demo@/imran.demo@alahadattars.com,
# password "Demo@12345") the first time it runs against an empty product table — useful
# for local dev/sales demos. Set to false before seeding a real deployment, since the
# password is visible in source.
SEED_DEMO_CUSTOMERS=true

# --- Transactional Email (SMTP) ---
# Powers EmailService: welcome, order confirmed/shipped/delivered, password reset, and the
# admin new-order notification. Leave MAIL_HOST/MAIL_USERNAME blank to disable sending entirely
# (safe — the app boots fine and every email call becomes a no-op with a logged warning; no
# order/registration ever fails because of this). Example values below are for Gmail SMTP —
# use an App Password, not your real account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# "From" address shown on outgoing mail. Doesn't have to match MAIL_USERNAME depending on
# your SMTP provider's rules (Gmail requires them to match).
MAIL_FROM=noreply@alahadattars.com
# Master on/off switch, independent of the host/username check above.
MAIL_ENABLED=true
# Who receives the "New Order Received" admin alert. Falls back to ADMIN_EMAIL if unset.
ADMIN_NOTIFICATION_EMAIL=
# Used to build links inside emails (login button, password reset link).
FRONTEND_URL=http://localhost:5173
# Shown in every email footer as the customer support contact.
SUPPORT_EMAIL=contact@alahadattars.com
# Comma-separated browser origins allowed to call this API (CORS). Defaults to FRONTEND_URL if
# unset. In production, set this to your real domain(s) — e.g.
# CORS_ALLOWED_ORIGINS=https://alahadattars.com,https://www.alahadattars.com — never a wildcard.
CORS_ALLOWED_ORIGINS=
# Comma-separated IP(s) of a reverse proxy/load balancer actually deployed in front of this app
# (e.g. nginx, an AWS ALB, Cloudflare). Leave unset until one exists — AuthRateLimitFilter only
# trusts the X-Forwarded-For header from these IPs; otherwise a client can spoof it to dodge the
# auth rate limit entirely.
TRUSTED_PROXIES=

# --- File uploads (STORAGE_PROVIDER=local dev fallback only — see below) ---
# Local directory for uploaded images when STORAGE_PROVIDER=local (or unset).
# Optional — defaults to "uploads" (relative to backend/) if unset.
UPLOAD_DIR=uploads

# --- Storage provider ---
# "r2" (Cloudflare R2 — the production provider; set this in every deployed environment), "local"
# (dev-only disk storage under UPLOAD_DIR, default here since it needs no credentials), or
# "supabase" (kept available as a fallback/alternative provider, but must NOT be the configured
# production provider — Supabase is production-only for Postgres, not storage). Business code
# (ProductImageService, ReviewService, CategoryService, HomepageService, ...) depends only on the
# StorageService interface, never on a specific provider — see backend/STORAGE_MIGRATION.md.
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=r2. Cloudflare dashboard > R2 > Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
# Server-side only — never sent to the frontend. React never talks to R2 directly; all
# uploads/deletes go through Spring Boot.
R2_SECRET_ACCESS_KEY=
# Must already exist in your Cloudflare account (R2 > Create bucket).
R2_BUCKET=
# The bucket's public R2.dev URL, or a custom domain you've connected to it (Cloudflare
# dashboard > R2 > <bucket> > Settings > Public access). No trailing slash. Images are served
# straight from this URL/CDN — never proxied through this backend.
R2_PUBLIC_URL=

# Required when STORAGE_PROVIDER=supabase. From Project Settings > API.
SUPABASE_URL=
# Required when STORAGE_PROVIDER=supabase. Server-side only — bypasses Row Level Security and
# must never be sent to the frontend (SUPABASE_ANON_KEY, unused by this backend, would be the
# only key ever safe there).
SUPABASE_SERVICE_ROLE_KEY=
# Bucket to upload into — must exist in the Supabase project and be public, since product/
# category/review/banner images are public storefront assets. Optional — defaults to "media".
SUPABASE_STORAGE_BUCKET=media
